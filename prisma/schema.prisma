datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["shared", "sim"]
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// ── Enums ──
enum UnitLevel {
  tk
  sd
  smp
  sma
  pesantren
  @@schema("sim")
}

enum UserRole {
  super_admin
  admin_unit
  guru
  karyawan
  orang_tua
  observer
  tim_ppdb
  @@schema("sim")
}

enum RegistrationStatus {
  pending_payment
  payment_uploaded
  payment_verified
  form_filling
  documents_uploaded
  medical_pending
  medical_uploaded
  verification
  observation_scheduled
  observation_done
  accepted
  rejected
  enrolled
  @@schema("sim")
}

enum PaymentStatus {
  pending
  uploaded
  verified
  rejected
  @@schema("sim")
}

enum Gender {
  male
  female
  @@schema("sim")
}

enum ParentType {
  father
  mother
  guardian
  @@schema("sim")
}

enum DocumentType {
  photo
  school_certificate
  birth_certificate
  family_card
  father_id
  mother_id
  medical_result
  @@schema("sim")
}

// ── Tables ──
model FoundationSettings {
  id                String    @id @default(uuid()) @db.Uuid
  foundationName    String    @default("Yayasan Alfida") @map("foundation_name") @db.VarChar(200)
  logoUrl           String?   @map("logo_url")
  bankName          String?   @map("bank_name") @db.VarChar(100)
  bankAccountNumber String?   @map("bank_account_number") @db.VarChar(50)
  bankAccountHolder String?   @map("bank_account_holder") @db.VarChar(200)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@map("foundation_settings")
  @@schema("sim")
}

model Unit {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(200)
  slug      String    @unique @db.VarChar(100)
  level     UnitLevel
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  unitSettings        UnitSettings?
  userRoles           UserRoleAssignment[]
  academicYears       AcademicYear[]
  classes             Class[]

  @@map("units")
  @@schema("sim")
}

model UnitSettings {
  id                    String    @id @default(uuid()) @db.Uuid
  unitId                String    @unique @map("unit_id") @db.Uuid
  logoUrl               String?   @map("logo_url")
  principalName         String?   @map("principal_name") @db.VarChar(200)
  principalNip          String?   @map("principal_nip") @db.VarChar(50)
  principalSignatureUrl String?   @map("principal_signature_url")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("unit_settings")
  @@schema("sim")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  fullName     String    @map("full_name") @db.VarChar(200)
  email        String    @unique @db.VarChar(255)
  phone        String?   @db.VarChar(30)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  roles         UserRoleAssignment[]
  sessions      Session[]
  registrations Registration[]

  @@map("users")
  @@schema("shared")
}

model UserRoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      UserRole
  unitId    String?  @map("unit_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, role, unitId])
  @@map("user_roles")
  @@schema("sim")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("sim")
}

model AcademicYear {
  id         String    @id @default(uuid()) @db.Uuid
  unitId     String    @map("unit_id") @db.Uuid
  name       String    @db.VarChar(50)
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  ppdbActive Boolean   @default(false) @map("ppdb_active")
  quota      Int       @default(0)
  registered Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  unit                 Unit                   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  registrations        Registration[]
  observationSchedules ObservationSchedule[]

  @@unique([unitId, name])
  @@map("academic_years")
  @@schema("sim")
}

model Registration {
  id                 String             @id @default(uuid()) @db.Uuid
  registrationNumber String             @unique @map("registration_number") @db.VarChar(50)
  parentId           String             @map("parent_id") @db.Uuid
  academicYearId     String             @map("academic_year_id") @db.Uuid
  status             RegistrationStatus @default(pending_payment)
  rejectionReason    String?            @map("rejection_reason")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime?          @updatedAt @map("updated_at") @db.Timestamptz

  parent             User                @relation(fields: [parentId], references: [id])
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  payment            Payment?
  studentData        StudentData?
  parentData         ParentData[]
  documents          Document[]
  medicalReferral    MedicalReferral?
  observationBooking ObservationBooking?
  classAssignment    ClassAssignment?

  @@map("registrations")
  @@schema("sim")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  registrationId String        @unique @map("registration_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  proofUrl       String?       @map("proof_url")
  status         PaymentStatus @default(pending)
  uploadedAt     DateTime?     @map("uploaded_at") @db.Timestamptz
  verifiedAt     DateTime?     @map("verified_at") @db.Timestamptz
  verifiedBy     String?       @map("verified_by") @db.Uuid
  rejectionNote  String?       @map("rejection_note")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@schema("sim")
}

model StudentData {
  id             String    @id @default(uuid()) @db.Uuid
  registrationId String    @unique @map("registration_id") @db.Uuid
  fullName       String    @map("full_name") @db.VarChar(200)
  nickname       String?   @db.VarChar(100)
  gender         Gender
  religion       String    @default("Islam") @db.VarChar(50)
  birthPlace     String    @map("birth_place") @db.VarChar(100)
  birthDate      DateTime  @map("birth_date") @db.Date
  nisn           String?   @db.VarChar(20)
  siblingsCount  Int       @default(0) @map("siblings_count")
  address        String
  transportation String?   @db.VarChar(100)
  hobby          String?   @db.VarChar(100)
  ambition       String?   @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("student_data")
  @@schema("sim")
}

model ParentData {
  id             String     @id @default(uuid()) @db.Uuid
  registrationId String     @map("registration_id") @db.Uuid
  type           ParentType
  fullName       String     @map("full_name") @db.VarChar(200)
  nik            String?    @db.VarChar(20)
  birthPlace     String?    @map("birth_place") @db.VarChar(100)
  birthDate      DateTime?  @map("birth_date") @db.Date
  education      String?    @db.VarChar(50)
  occupation     String?    @db.VarChar(100)
  phone          String?    @db.VarChar(30)
  incomeRange    String?    @map("income_range") @db.VarChar(50)
  address        String?
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?  @updatedAt @map("updated_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, type])
  @@map("parent_data")
  @@schema("sim")
}

model Document {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @map("registration_id") @db.Uuid
  type           DocumentType
  fileUrl        String       @map("file_url")
  fileName       String       @map("file_name") @db.VarChar(255)
  fileSize       Int          @map("file_size")
  mimeType       String       @map("mime_type") @db.VarChar(100)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("documents")
  @@schema("sim")
}

model MedicalReferral {
  id             String   @id @default(uuid()) @db.Uuid
  registrationId String   @unique @map("registration_id") @db.Uuid
  referralNumber String   @unique @map("referral_number") @db.VarChar(50)
  pdfUrl         String?  @map("pdf_url")
  resultFileUrl  String?  @map("result_file_url")
  issuedAt       DateTime @default(now()) @map("issued_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("medical_referrals")
  @@schema("sim")
}

model ObservationSchedule {
  id             String   @id @default(uuid()) @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  date           DateTime @db.Date
  startTime      String   @map("start_time") @db.VarChar(10)
  endTime        String   @map("end_time") @db.VarChar(10)
  quota          Int      @default(10)
  booked         Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  bookings     ObservationBooking[]

  @@map("observation_schedules")
  @@schema("sim")
}

model ObservationBooking {
  id                     String   @id @default(uuid()) @db.Uuid
  registrationId        String   @unique @map("registration_id") @db.Uuid
  observationScheduleId String   @map("observation_schedule_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  registration Registration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  schedule     ObservationSchedule @relation(fields: [observationScheduleId], references: [id], onDelete: Cascade)

  result ObservationResult?

  @@map("observation_bookings")
  @@schema("sim")
}

model ObservationResult {
  id                   String   @id @default(uuid()) @db.Uuid
  observationBookingId String   @unique @map("observation_booking_id") @db.Uuid
  observerId           String   @map("observer_id") @db.Uuid
  score                Decimal  @db.Decimal(5, 2)
  notes                String?
  rank                 Int?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  booking ObservationBooking @relation(fields: [observationBookingId], references: [id], onDelete: Cascade)

  @@map("observation_results")
  @@schema("sim")
}

model Class {
  id             String    @id @default(uuid()) @db.Uuid
  unitId         String    @map("unit_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  name           String    @db.VarChar(100)
  capacity       Int       @default(30)
  assigned       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  unit        Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assignments ClassAssignment[]

  @@unique([unitId, academicYearId, name])
  @@map("classes")
  @@schema("sim")
}

model ClassAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  registrationId String   @unique @map("registration_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("class_assignments")
  @@schema("sim")
}
