datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["shared", "sim"]
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
  output          = "../src/generated/client"
  previewFeatures = ["multiSchema"]
}

// ── Enums ──
enum UnitLevel {
  tk
  sd
  smp
  sma
  pesantren
  kantor_yayasan
  non_pendidikan

  @@schema("sim")
}

enum UserRole {
  super_admin
  admin_unit
  admin_unit_nondik
  guru
  karyawan
  orang_tua
  observer
  tim_ppdb
  admin_kepegawaian
  admin_bpi
  admin_bidang
  murobbi

  @@schema("sim")
}

enum RegistrationStatus {
  pending_payment
  payment_uploaded
  payment_verified
  form_filling
  documents_uploaded
  medical_pending
  medical_uploaded
  verification
  observation_scheduled
  observation_done
  accepted
  rejected
  enrolled

  @@schema("sim")
}

enum PaymentStatus {
  pending
  uploaded
  verified
  rejected

  @@schema("sim")
}

enum Gender {
  male
  female

  @@schema("sim")
}

enum ParentType {
  father
  mother
  guardian

  @@schema("sim")
}

enum DocumentType {
  photo
  school_certificate
  birth_certificate
  family_card
  father_id
  mother_id
  medical_result

  @@schema("sim")
}

// ── Tambahan Enums Akademik ──
enum EnrollmentStatus {
  active
  re_enrolled
  graduated
  dropped

  @@schema("sim")
}

enum EnrollmentType {
  new_ppdb
  re_enrollment

  @@schema("sim")
}

enum SubjectLevel {
  level_0  @map("0")
  level_1  @map("1")
  level_2  @map("2")
  level_3  @map("3")
  level_4  @map("4")
  level_5  @map("5")
  level_6  @map("6")
  level_7  @map("7")
  level_8  @map("8")
  level_9  @map("9")
  level_10 @map("10")
  level_11 @map("11")
  level_12 @map("12")
  level_13 @map("13")
  all

  @@schema("sim")
}

enum GradeType {
  daily
  exam
  ats
  aas

  @@schema("sim")
}

enum AttendanceStatus {
  present
  sick
  permitted
  absent

  @@schema("sim")
}

enum LessonPlanType {
  prota
  promes
  rpp

  @@schema("sim")
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday

  @@schema("sim")
}

enum SppStatus {
  unpaid
  uploaded
  verified
  rejected

  @@schema("sim")
}

enum SemesterType {
  mid
  final

  @@schema("sim")
}

enum PromotionStatus {
  promoted
  retained

  @@schema("sim")
}

// ── Tambahan Enums Fase 3 ──
enum GpsAttendanceStatus {
  present
  late
  absent
  leave

  @@schema("sim")
}

enum LeaveType {
  cuti
  sakit
  izin

  @@schema("sim")
}

enum LeaveStatus {
  pending
  approved
  rejected

  @@schema("sim")
}

enum ReportType {
  weekly
  monthly

  @@schema("sim")
}

// ── Tables ──
model FoundationSettings {
  id                   String    @id @default(uuid()) @db.Uuid
  foundationName       String    @default("Yayasan Alfida") @map("foundation_name") @db.VarChar(200)
  logoUrl              String?   @map("logo_url")
  chairmanName         String?   @map("chairman_name") @db.VarChar(200)
  chairmanSignatureUrl String?   @map("chairman_signature_url")
  bankName             String?   @map("bank_name") @db.VarChar(100)
  bankAccountNumber    String?   @map("bank_account_number") @db.VarChar(50)
  bankAccountHolder    String?   @map("bank_account_holder") @db.VarChar(200)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@map("foundation_settings")
  @@schema("sim")
}

model Unit {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(200)
  slug      String    @unique @db.VarChar(100)
  level     UnitLevel
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  unitSettings     UnitSettings?
  userRoles        UserRoleAssignment[]
  academicYears    AcademicYear[]
  classes          Class[]
  subjects         Subject[]
  extracurriculars Extracurricular[]

  // Modul Karyawan (Fase 3)
  departments         Department[]
  holidays            Holiday[]
  gpsAttendanceConfig GpsAttendanceConfig?
  gpsAttendances      GpsAttendance[]

  @@index([isActive])
  @@map("units")
  @@schema("sim")
}

model UnitSettings {
  id                    String    @id @default(uuid()) @db.Uuid
  unitId                String    @unique @map("unit_id") @db.Uuid
  logoUrl               String?   @map("logo_url")
  principalName         String?   @map("principal_name") @db.VarChar(200)
  principalNip          String?   @map("principal_nip") @db.VarChar(50)
  principalSignatureUrl String?   @map("principal_signature_url")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("unit_settings")
  @@schema("sim")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String?   @unique @db.VarChar(100)
  fullName     String    @map("full_name") @db.VarChar(200)
  firstName    String?   @map("first_name") @db.VarChar(100)
  lastName     String?   @map("last_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  phone        String?   @db.VarChar(30)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  groups       String[] // Fitur PostgreSQL: Array of strings
  isActive     Boolean   @default(true) @map("is_active")
  leaveQuota   Int       @default(12) @map("leave_quota")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  roles               UserRoleAssignment[]
  sessions            Session[]
  registrations       Registration[]
  enrollmentsParent   StudentEnrollment[]      @relation("EnrollmentParent")
  teacherAssignments  TeacherAssignment[]      @relation("TeacherAssignments")
  homeroomAssignments HomeroomAssignment[]     @relation("HomeroomAssignments")
  gradeTeacher        Grade[]                  @relation("GradeTeacher")
  attendanceTeacher   Attendance[]             @relation("AttendanceTeacher")
  teachingJournals    TeachingJournal[]        @relation("TeachingJournals")
  lessonPlans         LessonPlan[]             @relation("LessonPlans")
  classSchedules      ClassSchedule[]          @relation("ClassSchedules")
  extraCoaches        ExtracurricularCoach[]   @relation("ExtraCoaches")
  extraJournals       ExtracurricularJournal[] @relation("ExtraJournals")
  promotionDecisions  PromotionDecision[]      @relation("PromotionDecider")

  // Modul Karyawan (Fase 3)
  departmentAdmins    DepartmentAdmin[]
  gpsAttendances      GpsAttendance[]
  liqoGroupsAsMurobbi LiqoGroup[]
  liqoMemberships     LiqoMember[]
  liqoAttendances     LiqoAttendance[]
  mutabaahRecords     MutabaahRecord[]
  leaveRequests       LeaveRequest[]    @relation("UserLeaveRequests")
  approvedLeaves      LeaveRequest[]    @relation("ApprovedLeaves")
  workProgramsAsPIC   WorkProgram[]     @relation("WorkProgramsPIC")
  activityReports     ActivityReport[]  @relation("SubmittedActivityReports")

  @@index([isActive])
  @@map("users")
  @@schema("shared")
}

model UserRoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      UserRole
  unitId    String?  @map("unit_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, role, unitId])
  @@map("user_roles")
  @@schema("sim")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("sim")
}

model AcademicYear {
  id         String    @id @default(uuid()) @db.Uuid
  unitId     String    @map("unit_id") @db.Uuid
  name       String    @db.VarChar(50)
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  ppdbActive Boolean   @default(false) @map("ppdb_active")
  quota      Int       @default(0)
  registered Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  unit                 Unit                    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  registrations        Registration[]
  observationSchedules ObservationSchedule[]
  studentEnrollments   StudentEnrollment[]
  teacherAssignments   TeacherAssignment[]
  homeroomAssignments  HomeroomAssignment[]    @relation("HomeroomAssignments")
  grades               Grade[]
  lessonPlans          LessonPlan[]
  extraCoaches         ExtracurricularCoach[]
  extraMemberships     ExtracurricularMember[]
  lhbsReports          LhbsReport[]
  workPrograms         WorkProgram[]

  @@unique([unitId, name])
  @@map("academic_years")
  @@schema("sim")
}

model Registration {
  id                 String             @id @default(uuid()) @db.Uuid
  registrationNumber String             @unique @map("registration_number") @db.VarChar(50)
  parentId           String             @map("parent_id") @db.Uuid
  academicYearId     String             @map("academic_year_id") @db.Uuid
  status             RegistrationStatus @default(pending_payment)
  rejectionReason    String?            @map("rejection_reason")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime?          @updatedAt @map("updated_at") @db.Timestamptz

  parent             User                @relation(fields: [parentId], references: [id])
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  payment            Payment?
  studentData        StudentData?
  parentData         ParentData[]
  documents          Document[]
  medicalReferral    MedicalReferral?
  observationBooking ObservationBooking?
  classAssignment    ClassAssignment?
  studentEnrollments StudentEnrollment[]

  @@map("registrations")
  @@schema("sim")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  registrationId String        @unique @map("registration_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  proofUrl       String?       @map("proof_url")
  status         PaymentStatus @default(pending)
  uploadedAt     DateTime?     @map("uploaded_at") @db.Timestamptz
  verifiedAt     DateTime?     @map("verified_at") @db.Timestamptz
  verifiedBy     String?       @map("verified_by") @db.Uuid
  rejectionNote  String?       @map("rejection_note")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@schema("sim")
}

model StudentData {
  id             String    @id @default(uuid()) @db.Uuid
  registrationId String    @unique @map("registration_id") @db.Uuid
  fullName       String    @map("full_name") @db.VarChar(200)
  nickname       String?   @db.VarChar(100)
  gender         Gender
  religion       String    @default("Islam") @db.VarChar(50)
  birthPlace     String    @map("birth_place") @db.VarChar(100)
  birthDate      DateTime  @map("birth_date") @db.Date
  nisn           String?   @db.VarChar(20)
  siblingsCount  Int       @default(0) @map("siblings_count")
  address        String
  transportation String?   @db.VarChar(100)
  hobby          String?   @db.VarChar(100)
  ambition       String?   @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  registration       Registration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  studentEnrollments StudentEnrollment[]

  @@map("student_data")
  @@schema("sim")
}

model ParentData {
  id             String     @id @default(uuid()) @db.Uuid
  registrationId String     @map("registration_id") @db.Uuid
  type           ParentType
  fullName       String     @map("full_name") @db.VarChar(200)
  nik            String?    @db.VarChar(20)
  birthPlace     String?    @map("birth_place") @db.VarChar(100)
  birthDate      DateTime?  @map("birth_date") @db.Date
  education      String?    @db.VarChar(50)
  occupation     String?    @db.VarChar(100)
  phone          String?    @db.VarChar(30)
  incomeRange    String?    @map("income_range") @db.VarChar(50)
  address        String?
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?  @updatedAt @map("updated_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, type])
  @@map("parent_data")
  @@schema("sim")
}

model Document {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @map("registration_id") @db.Uuid
  type           DocumentType
  fileUrl        String       @map("file_url")
  fileName       String       @map("file_name") @db.VarChar(255)
  fileSize       Int          @map("file_size")
  mimeType       String       @map("mime_type") @db.VarChar(100)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("documents")
  @@schema("sim")
}

model MedicalReferral {
  id             String   @id @default(uuid()) @db.Uuid
  registrationId String   @unique @map("registration_id") @db.Uuid
  referralNumber String   @unique @map("referral_number") @db.VarChar(50)
  pdfUrl         String?  @map("pdf_url")
  resultFileUrl  String?  @map("result_file_url")
  issuedAt       DateTime @default(now()) @map("issued_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("medical_referrals")
  @@schema("sim")
}

model ObservationSchedule {
  id             String   @id @default(uuid()) @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  date           DateTime @db.Date
  startTime      String   @map("start_time") @db.VarChar(10)
  endTime        String   @map("end_time") @db.VarChar(10)
  quota          Int      @default(10)
  booked         Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  bookings     ObservationBooking[]

  @@map("observation_schedules")
  @@schema("sim")
}

model ObservationBooking {
  id                    String   @id @default(uuid()) @db.Uuid
  registrationId        String   @unique @map("registration_id") @db.Uuid
  observationScheduleId String   @map("observation_schedule_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  registration Registration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  schedule     ObservationSchedule @relation(fields: [observationScheduleId], references: [id], onDelete: Cascade)

  result ObservationResult?

  @@map("observation_bookings")
  @@schema("sim")
}

model ObservationResult {
  id                   String   @id @default(uuid()) @db.Uuid
  observationBookingId String   @unique @map("observation_booking_id") @db.Uuid
  observerId           String   @map("observer_id") @db.Uuid
  score                Decimal  @db.Decimal(5, 2)
  notes                String?
  rank                 Int?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  booking ObservationBooking @relation(fields: [observationBookingId], references: [id], onDelete: Cascade)

  @@map("observation_results")
  @@schema("sim")
}

model Class {
  id             String    @id @default(uuid()) @db.Uuid
  unitId         String    @map("unit_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  name           String    @db.VarChar(100)
  capacity       Int       @default(30)
  assigned       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  unit                Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assignments         ClassAssignment[]
  homeroomAssignments HomeroomAssignment[] @relation("HomeroomAssignments")
  studentEnrollments  StudentEnrollment[]
  teacherAssignments  TeacherAssignment[]
  teachingJournals    TeachingJournal[]
  classSchedules      ClassSchedule[]

  @@unique([unitId, academicYearId, name])
  @@map("classes")
  @@schema("sim")
}

model ClassAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  registrationId String   @unique @map("registration_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("class_assignments")
  @@schema("sim")
}

// ── Models Akademik ──

model StudentEnrollment {
  id             String           @id @default(uuid()) @db.Uuid
  registrationId String?          @map("registration_id") @db.Uuid
  classId        String           @map("class_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  studentDataId  String           @map("student_data_id") @db.Uuid
  parentId       String           @map("parent_id") @db.Uuid
  status         EnrollmentStatus @default(active)
  enrollmentType EnrollmentType   @map("enrollment_type")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?        @updatedAt @map("updated_at") @db.Timestamptz

  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  class        Class         @relation(fields: [classId], references: [id], onDelete: Restrict)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  studentData  StudentData   @relation(fields: [studentDataId], references: [id], onDelete: Cascade)
  parent       User          @relation("EnrollmentParent", fields: [parentId], references: [id], onDelete: Restrict)

  grades            Grade[]
  attendances       Attendance[]
  extraMemberships  ExtracurricularMember[]
  extraGrades       ExtracurricularGrade[]
  sppInvoices       SppInvoice[]
  lhbsReports       LhbsReport[]
  promotionDecision PromotionDecision?

  @@unique([studentDataId, academicYearId])
  @@index([status])
  @@index([academicYearId])
  @@map("student_enrollments")
  @@schema("sim")
}

model Subject {
  id        String       @id @default(uuid()) @db.Uuid
  unitId    String       @map("unit_id") @db.Uuid
  code      String       @db.VarChar(20)
  name      String       @db.VarChar(100)
  level     SubjectLevel
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime?    @updatedAt @map("updated_at") @db.Timestamptz

  unit               Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  grades             Grade[]
  attendances        Attendance[]
  teachingJournals   TeachingJournal[]
  lessonPlans        LessonPlan[]
  classSchedules     ClassSchedule[]

  @@unique([unitId, code])
  @@map("subjects")
  @@schema("sim")
}

model TeacherAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  teacherId      String   @map("teacher_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      User         @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId, classId, academicYearId])
  @@map("teacher_assignments")
  @@schema("sim")
}

model HomeroomAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  teacherId      String   @map("teacher_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher      User         @relation("HomeroomAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  class        Class        @relation("HomeroomAssignments", fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation("HomeroomAssignments", fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([classId, academicYearId])
  @@map("homeroom_assignments")
  @@schema("sim")
}

model Grade {
  id             String    @id @default(uuid()) @db.Uuid
  enrollmentId   String    @map("enrollment_id") @db.Uuid
  subjectId      String    @map("subject_id") @db.Uuid
  teacherId      String    @map("teacher_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  type           GradeType
  label          String    @db.VarChar(50)
  score          Decimal   @db.Decimal(5, 2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  subject      Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      User              @relation("GradeTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@index([academicYearId])
  @@map("grades")
  @@schema("sim")
}

model Attendance {
  id           String           @id @default(uuid()) @db.Uuid
  enrollmentId String           @map("enrollment_id") @db.Uuid
  subjectId    String           @map("subject_id") @db.Uuid
  teacherId    String           @map("teacher_id") @db.Uuid
  date         DateTime         @db.Date
  status       AttendanceStatus
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  subject    Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    User              @relation("AttendanceTeacher", fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, subjectId, date])
  @@index([date])
  @@index([status])
  @@map("attendances")
  @@schema("sim")
}

model TeachingJournal {
