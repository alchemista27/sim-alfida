  @@schema("sim")
}

model Extracurricular {
  id          String   @id @default(uuid()) @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  unit      Unit                      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  coaches   ExtracurricularCoach[]
  schedules ExtracurricularSchedule[]
  members   ExtracurricularMember[]
  journals  ExtracurricularJournal[]

  @@unique([unitId, name])
  @@map("extracurriculars")
  @@schema("sim")
}

model ExtracurricularCoach {
  id             String   @id @default(uuid()) @db.Uuid
  extraId        String   @map("extra_id") @db.Uuid
  coachId        String   @map("coach_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  extracurricular Extracurricular @relation(fields: [extraId], references: [id], onDelete: Cascade)
  coach           User            @relation("ExtraCoaches", fields: [coachId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([extraId, coachId, academicYearId])
  @@map("extracurricular_coaches")
  @@schema("sim")
}

model ExtracurricularSchedule {
  id        String    @id @default(uuid()) @db.Uuid
  extraId   String    @map("extra_id") @db.Uuid
  day       DayOfWeek
  startTime String    @map("start_time") @db.VarChar(10)
  endTime   String    @map("end_time") @db.VarChar(10)
  location  String?   @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  extracurricular Extracurricular @relation(fields: [extraId], references: [id], onDelete: Cascade)

  @@map("extracurricular_schedules")
  @@schema("sim")
}

model ExtracurricularMember {
  id             String   @id @default(uuid()) @db.Uuid
  extraId        String   @map("extra_id") @db.Uuid
  enrollmentId   String   @map("enrollment_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz

  extracurricular Extracurricular        @relation(fields: [extraId], references: [id], onDelete: Cascade)
  enrollment      StudentEnrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  grades          ExtracurricularGrade[]

  @@unique([extraId, enrollmentId, academicYearId])
  @@map("extracurricular_members")
  @@schema("sim")
}

model ExtracurricularJournal {
  id         String   @id @default(uuid()) @db.Uuid
  extraId    String   @map("extra_id") @db.Uuid
  coachId    String   @map("coach_id") @db.Uuid
  date       DateTime @db.Date
  activity   String
  attendance Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  extracurricular Extracurricular @relation(fields: [extraId], references: [id], onDelete: Cascade)
  coach           User            @relation("ExtraJournals", fields: [coachId], references: [id], onDelete: Restrict)

  @@map("extracurricular_journals")
  @@schema("sim")
}

model ExtracurricularGrade {
  id           String       @id @default(uuid()) @db.Uuid
  memberId     String       @map("member_id") @db.Uuid
  enrollmentId String       @map("enrollment_id") @db.Uuid
  semester     SemesterType
  score        String       @db.VarChar(2) // A, B, C, D
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  member     ExtracurricularMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  enrollment StudentEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([memberId, semester])
  @@map("extracurricular_grades")
  @@schema("sim")
}

model SppInvoice {
  id            String    @id @default(uuid()) @db.Uuid
  enrollmentId  String    @map("enrollment_id") @db.Uuid
  month         Int       @db.SmallInt // 1-12
  year          Int       @db.SmallInt
  amount        Decimal   @db.Decimal(12, 2)
  status        SppStatus @default(unpaid)
  proofUrl      String?   @map("proof_url")
  uploadedAt    DateTime? @map("uploaded_at") @db.Timestamptz
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz
  verifiedBy    String?   @map("verified_by") @db.Uuid
  rejectionNote String?   @map("rejection_note")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, month, year])
  @@map("spp_invoices")
  @@schema("sim")
}

model LhbsReport {
  id             String       @id @default(uuid()) @db.Uuid
  enrollmentId   String       @map("enrollment_id") @db.Uuid
  semester       SemesterType
  academicYearId String       @map("academic_year_id") @db.Uuid
  pdfUrl         String?      @map("pdf_url")
  gradesSnapshot Json         @map("grades_snapshot") // Snapshot of all subject grades
  extraSnapshot  Json?        @map("extra_snapshot") // Snapshot of extracurricular grades
  attendanceSum  Json         @map("attendance_sum") // Summary of sick, absent, permitted
